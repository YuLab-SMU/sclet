Package: sclet
Title: A State-Aware Single-Cell and Spatial Transcriptomics Toolkit for SingleCellExperiment
Version: 1.0.1
Authors@R: c(
    person(given = "Guangchuang", family = "Yu", email = "guangchuangyu@gmail.com", role  = c("aut", "cre"), comment = c(ORCID = "0000-0002-6485-8781")),
    person(given = "Kaijia", family = "Huang", email = "2947569391@qq.com", role  = "ctb"),
    person(given = "Nan", family = "He", email = "hinna@i.smu.edu.cn", role  = "ctb"),
    person(given = "Ming", family = "Li", email = "limiang929@gmail.com", role = "ctb"),
    person(given = "Junrui", family = "Li", email = "1523467190@qq.com", role = "ctb")
