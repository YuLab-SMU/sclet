Package: sclet
Title: A State-Aware Single-Cell and Spatial Transcriptomics Toolkit for SingleCellExperiment
Version: 1.0.0
Authors@R: c(
    person(given = "Guangchuang", family = "Yu", email = "guangchuangyu@gmail.com", role  = c("aut", "cre"), comment = c(ORCID = "0000-0002-6485-8781")),
